APP_NAME=Swatcher
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Berlin

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=swatcher
DB_USERNAME=swatcher
DB_PASSWORD=secret

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost

QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@swatcher.local
MAIL_FROM_NAME="Swatcher"

SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000

VICTORIAMETRICS_URL=http://victoriametrics:8428
VICTORIAMETRICS_RETENTION=90d

SWATCHER_POLL_INTERVAL=60
SWATCHER_DEFAULT_RETENTION_DAYS=90
